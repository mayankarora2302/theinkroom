# ─── Frontend (Next.js) ───────────────────────────────────────────────
# Public URL of this site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Express API runs. Server-side only — the browser reaches it through /api/v1.
BACKEND_URL=http://localhost:4000

# Origin that serves tattoo photographs, allowed for Next.js image optimisation.
# For Supabase Storage this is your project URL:
MEDIA_ORIGIN=https://<project-ref>.supabase.co

# Set to 1 only when the API uses STORAGE_DRIVER=local (offline development).
IMAGES_ALLOW_LOCAL=0

# Shared secret the API uses to refresh cached pages after admin changes.
# Must match REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=
NEXT_PUBLIC_MAX_UPLOAD_MB=15
