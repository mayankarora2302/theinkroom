# ─── Backend (Express API) ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public origin of the Next.js site. Used for strict CORS + CSRF origin checks.
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL (Project Settings → Database → Connection string)
# Pooled connection (Transaction pooler, port 6543) used by the running API:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct connection (port 5432) used by `prisma migrate`:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Image storage driver: "supabase" (default, required in production) or "local"
# ("local" writes to ./uploads and is for offline development only).
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key: SERVER ONLY. Never put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio

# Only used when STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
# Public base URL where the API serves local uploads
PUBLIC_API_URL=http://localhost:4000

# Upload limit for original photographs, in megabytes
MAX_UPLOAD_MB=15

# Admin sessions
SESSION_TTL_HOURS=168

# Number of proxy hops in front of the API. The Next.js site proxies /api/v1, so 1 locally;
# add one for each load balancer in front of it. Use 0 if the API is exposed directly.
TRUST_PROXY=1

# On-demand revalidation of the public site after admin changes.
# Must match REVALIDATE_SECRET in frontend/.env.local. Leave blank to rely on timed revalidation.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
